{
    "name": "chrome-subscribe-save-oneclick-cancel",
    "version": "1.0.0",
    "description": "Amazon Subscribe & Save one-click cancel browser extension",
    "license": "MIT",
    "author": "Long Zheng",
    "repository": {
        "type": "git",
        "url": "https://github.com/longzheng/chrome-subscribe-save-oneclick-cancel.git"
    },
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite",
        "build": "pnpm run clean && pnpm run build:chrome && pnpm run build:firefox",
        "build:chrome": "vite build --mode chrome",
        "build:firefox": "vite build --mode firefox",
        "clean": "rimraf dist chrome-subscribe-save-oneclick-cancel.zip firefox-subscribe-save-oneclick-cancel.zip firefox-subscribe-save-oneclick-cancel.xpi",
        "test": "pnpm exec jest --passWithNoTests",
        "lint": "oxlint .",
        "build-zip": "pnpm run build && pnpm run build-zip:chrome && pnpm run build-zip:firefox",
        "build-zip:chrome": "cd dist/chrome && zip -r ../../chrome-subscribe-save-oneclick-cancel.zip *",
        "build-zip:firefox": "cd dist/firefox && zip -r ../../firefox-subscribe-save-oneclick-cancel.zip *",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "raygun4js": "^3.1.4"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.4.0",
        "@tsconfig/strictest": "^2.0.8",
        "@types/chrome": "0.1.38",
        "@types/jest": "^30.0.0",
        "@types/raygun4js": "^3.0.0",
        "jest": "^30.3.0",
        "oxfmt": "^0.43.0",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^0.18.1",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.6",
        "typescript": "^6.0.2",
        "vite": "^8.0.3",
        "web-ext": "10.5.0"
    },
    "packageManager": "pnpm@10.13.1"
}
